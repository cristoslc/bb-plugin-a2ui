{
  "name": "bb-plugin-a2ui",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "bb": ">=0.50",
    "bbPluginSdk": ">=0.6.157"
  },
  "bb": {
    "name": "A2UI",
