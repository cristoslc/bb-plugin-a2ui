      "icon": "Boxes"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": [
      "skills"
    ]
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.157",
    "@pierre/diffs": "~1.2.12",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-hover-card": "^1.2.1",
    "@radix-ui/react-menubar": "^1.2.1",
    "@radix-ui/react-navigation-menu": "^1.4.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.5.0",
    "hono": "^4.11.9",
    "puppeteer-core": "^25.18.1",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.7.0",
    "typescript": "^5.7.0",
    "vaul": "^1.1.2",
    "vite": "^7.3.8",
    "vitest": "^3.2.7",
    "yaml": "^2.9.1"
  },
  "scripts": {
    "build": "bb plugin build",
    "catalog:build": "node scripts/build-catalog.mjs",
    "test": "vitest run",
    "uat": "node scripts/uat/run.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
